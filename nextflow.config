manifest {
    name = 'nf-frontend-canary'
    description = 'A small pipeline with a parameter schema, a samplesheet schema, and a forced failure.'
    nextflowVersion = '>=26.04.6'
}

params {
    input = null
    outdir = null
    fail = false
}

process {
    container = 'ubuntu@sha256:73b999393d07f2bf65a40373778a44dc9a6d54ad7718d29247d8ff9413c4d6a8'
    shell = ['/bin/bash', '-euo', 'pipefail']
}

profiles {
    test {
        params.input = "${projectDir}/assets/test_samplesheet.csv"
    }
}
